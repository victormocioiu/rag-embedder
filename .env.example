MODEL_ID=intfloat/multilingual-e5-small
MODEL_PATH=/models/onnx-int8
EMBED_DIMENSIONS=384
MAX_SEQUENCE_LENGTH=512

# From `grep -o 'avx512[a-z_]*' /proc/cpuinfo`.
# Current node is AMD EPYC Genoa: AVX-512 WITH vnni -> avx512_vnni
QUANTIZATION_TARGET=avx512_vnni

BATCH_MAX_SIZE=32
BATCH_MAX_WAIT_MS=10

# Must not exceed the pod's cpu LIMIT (threads > cgroup quota thrashes).
# Thread count is measured, not guessed: see docs/benchmarks-1.2.md.
INTRA_OP_NUM_THREADS=1
INTER_OP_NUM_THREADS=1
INFERENCE_WORKERS=1
